# Copy to .env and fill in. Test and production use separate databases and buckets.

# --- Site -----------------------------------------------------------------
# Canonical public origin of this deployment (no trailing slash). Better Auth
# base URL (cookies are Secure when it is https) and the R2 CORS origin.
# Inlined at build time, so set it per environment.
#   local: http://localhost:4321   test: the Vercel custom domain   prod: the real domain
# Vercel previews also answer on VERCEL_URL / VERCEL_BRANCH_URL automatically.
PUBLIC_SITE_URL=http://localhost:4321
# Search engines may crawl this deployment (robots.txt, sitemap). `true` in
# production only; everywhere else robots.txt answers "Disallow: /".
ALLOW_INDEXING=false

# --- Deploy ---------------------------------------------------------------
# Adapter selection in astro.config.mjs: `node` (Fly.io, default) or `vercel`.
DEPLOY_TARGET=node

# --- Database: Neon Postgres ---------------------------------------------
# Pooled connection string, used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct (non-pooled) connection, used by drizzle-kit for migrations.
# Optional: falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Map (page /ban-do): MapLibre GL + OpenFreeMap, no API key ----------
# Optional. Defaults to https://tiles.openfreemap.org/styles/liberty.
# PUBLIC_MAP_STYLE_URL=

# --- Auth: Better Auth (landlords only) ------------------------------------
# Random string, at least 32 chars: `openssl rand -base64 32`.
# Different per environment.
BETTER_AUTH_SECRET=
# Optional: extra hosts allowed to serve auth, comma separated (no scheme).
# BETTER_AUTH_ALLOWED_HOSTS=
# Optional: header with the real client IP for rate limiting.
# Set `fly-client-ip` on Fly.io. Leave unset on Vercel and locally.
# CLIENT_IP_HEADER=

# --- Email: password reset, email verification, contact requests -----------
# All mail goes through src/lib/email.ts. EMAIL_TRANSPORT picks how:
#   console (default)  prints subject, recipient and links to the server console
#                      in dev; in a production build nothing is sent and links
#                      are never logged (password resets then do not arrive).
#   gmail              Gmail SMTP. TEMPORARY until we have a domain; capped at
#                      480 sends/day (warning from 400). Switch to resend + a
#                      domain before launch.
#   resend             Resend API with a verified domain (RESEND_API_KEY + EMAIL_FROM).
# Check templates in a real inbox: npm run email:test -- you@example.com
EMAIL_TRANSPORT=console
# gmail: the Gmail address that sends (also the From address; the sender name
# is the site name).
GMAIL_USER=
# gmail: a 16-character App Password, NOT the account password. Needs 2-Step
# Verification on the account, then Google Account -> Security -> App
# passwords. Paste it without spaces. Never commit or log it.
GMAIL_APP_PASSWORD=
# resend: create an account, verify your sending domain (DNS records), then
# API Keys -> Create API Key ("Sending access"), one per environment. Starts with "re_".
RESEND_API_KEY=
# resend: sender on the verified domain, e.g. "PML Home <no-reply@yourdomain.vn>".
EMAIL_FROM=
# Public contact address for privacy / data requests (shown on the policy pages).
# CONTACT_EMAIL=

# --- Chat assistant: Gemini (POST /api/tro-ly) ------------------------------
# Without GEMINI_API_KEY the chat button is hidden and the API answers 503.
# Use a key on a paid (billing-enabled) project: on the free tier Google may
# use prompts and answers to improve its products.
# GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (fast enough for chat).
# GEMINI_MODEL=
# Optional. Tried when GEMINI_MODEL is overloaded. Defaults to gemini-3.6-flash.
# GEMINI_FALLBACK_MODEL=
# Optional. Messages per client IP per hour, default 20.
# CHAT_RATE_LIMIT_PER_HOUR=

# --- Contact form ---------------------------------------------------------
# Optional. Contact requests per client IP per hour. Defaults to 5.
# CONTACT_RATE_LIMIT_PER_HOUR=
# Optional. "Gọi điện" redirects per client IP per hour (the landlord's phone
# number is only revealed through this redirect). Defaults to 30.
# PHONE_RATE_LIMIT_PER_HOUR=
# Optional. "Nhắn Zalo" redirects per client IP per hour (the landlord's number
# is only revealed through this redirect). Defaults to 30.
# ZALO_RATE_LIMIT_PER_HOUR=

# --- Seed (npm run db:seed, never in production) --------------------------
# Password for every seeded landlord (landlord-01@example.test, ...).
SEED_PASSWORD=

# --- Ownership test, HTTP part (npm run test:ownership) -------------------
# Optional. With npm run dev running, e.g. http://localhost:4321.
# BASE_URL=

# --- Image storage: Cloudflare R2 through the S3 API -------------------------
# One bucket per environment (test / production), each with its own API token
# scoped to that bucket (Object Read & Write). S3 endpoint is derived:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL that serves the bucket (r2.dev subdomain or custom domain), no
# trailing slash. Inlined at build time.
PUBLIC_IMAGE_BASE_URL=
# Extra origins allowed to PUT to the bucket, comma separated, for
# `npm run r2:cors` (PUBLIC_SITE_URL is always included).
# R2_CORS_EXTRA_ORIGINS=

# --- Seed guard (npm run db:seed refuses to touch production) --------------
# Neon endpoint id of the production branch (the `ep-...` part of its host)
# and the production bucket name. Required by the seed script.
PRODUCTION_DB_ENDPOINT=
PRODUCTION_R2_BUCKET=
