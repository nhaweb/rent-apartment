---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ChatLauncher from '../components/chat/ChatLauncher.astro';
import { isChatEnabled } from '../lib/chat/assistant';
import { getAuthState } from '../lib/auth';
import { getWardOptions, type WardOption } from '../lib/rooms';
import type { JsonLd as JsonLdData } from '../lib/seo';
import type { RoomFilters } from '../lib/validation/room-filters';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** See `BaseLayout`. */
  canonical?: string;
  ogType?: 'website' | 'article';
  jsonLd?: JsonLdData[];
  /** Pass when the page already loaded them, to save a query. */
  wards?: WardOption[];
  /** Current listing filters, to prefill the header search. */
  filters?: RoomFilters;
  /** Home renders its own large search, so it hides the header one. */
  headerSearch?: boolean;
  /** Full-screen pages (the map) leave the footer out. */
  footer?: boolean;
  noindex?: boolean;
  /** Floating chat assistant. Default: on for indexable pages, when `GEMINI_API_KEY` is set. */
  chat?: boolean;
  /** Room shown on this page, for questions like "phòng này" (room detail page). */
  chatRoomId?: string;
}

const { title, description, image, imageWidth, imageHeight, canonical, ogType, jsonLd, filters, headerSearch = true, footer = true, noindex, chatRoomId } =
  Astro.props;
const chat = (Astro.props.chat ?? !noindex) && isChatEnabled();
const wards = Astro.props.wards ?? (await getWardOptions());
// Landlord links in the header and footer. No DB call without a session cookie,
// and responses with one are never shared-cached (`setPublicCache`).
const signedIn = Boolean(await getAuthState(Astro));
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  noindex={noindex}
  canonical={canonical}
  ogType={ogType}
  jsonLd={jsonLd}
>
  <a
    href="#noi-dung"
    class="sr-only z-50 rounded-md bg-ink px-4 py-3 text-inv-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >
    Bỏ qua, đến nội dung chính
  </a>
  <SiteHeader wards={wards} filters={filters} showSearch={headerSearch} signedIn={signedIn} />
  <main id="noi-dung">
    <slot />
  </main>
  {footer && <SiteFooter wards={wards} signedIn={signedIn} />}
  {chat && <ChatLauncher roomId={chatRoomId} aboveActionBar={Boolean(chatRoomId)} />}
</BaseLayout>
