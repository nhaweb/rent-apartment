---
/**
 * Labeled text field. `as="textarea"` renders a multi-line field (its
 * `value` becomes the textarea content). Other attributes (name, type, required, pattern...) pass through.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'> & HTMLAttributes<'textarea'>, 'class' | 'id'> & {
  id: string;
  label: string;
  as?: 'input' | 'textarea';
  /** Adds "(không bắt buộc)" after the label. */
  optional?: boolean;
  error?: string;
  class?: string;
};

const { id, label, as = 'input', optional = false, error, class: className, value, ...rest } = Astro.props;

const errorId = error ? `${id}-error` : undefined;
const field = {
  id,
  'aria-invalid': error ? 'true' : undefined,
  'aria-describedby': errorId,
  class: [
    'transition-feedback block min-h-11 w-full rounded-lg border bg-paper px-3 py-2.5 text-body text-ink placeholder:text-muted',
    error ? 'border-danger' : 'border-line hover:border-muted focus-visible:border-accent',
    as === 'textarea' && 'resize-y',
  ]
    .filter(Boolean)
    .join(' '),
  ...rest,
};
---

<div class={className}>
  <label for={id} class="mb-1.5 block text-small font-medium text-ink">
    {label}
    {optional && <span class="font-normal text-muted"> (không bắt buộc)</span>}
  </label>
  {
    as === 'textarea' ? (
      <textarea {...(field as HTMLAttributes<'textarea'>)}>{value}</textarea>
    ) : (
      <input {...(field as HTMLAttributes<'input'>)} value={value} />
    )
  }
  {error && <p id={errorId} class="mt-1.5 text-small text-danger">{error}</p>}
</div>
