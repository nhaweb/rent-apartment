---
import Button from './Button.astro';

interface Props {
  page: number;
  pageCount: number;
  /** Builds the href for a page number. */
  hrefFor: (page: number) => string;
}

const { page, pageCount, hrefFor } = Astro.props;

/**
 * First, last, and the current page with one neighbor on each side; gaps of
 * more than one page collapse to "…" (1 … 4 5 6 … 20). A gap of exactly one
 * page shows that page instead of an ellipsis.
 */
const shown = new Set([1, pageCount, page - 1, page, page + 1].filter((n) => n >= 1 && n <= pageCount));
const sorted = [...shown].sort((a, b) => a - b);
const items: (number | 'gap')[] = [];
for (const number of sorted) {
  const previous = items.at(-1);
  if (typeof previous === 'number' && number - previous === 2) items.push(previous + 1);
  else if (typeof previous === 'number' && number - previous > 2) items.push('gap');
  items.push(number);
}
---

{
  pageCount > 1 && (
    <nav aria-label="Phân trang" class="flex flex-wrap items-center justify-center gap-2">
      {page > 1 ? (
        <Button href={hrefFor(page - 1)} rel="prev" variant="outline" size="sm">
          Trang trước
        </Button>
      ) : null}
      {items.map((item) =>
        item === 'gap' ? (
          <span aria-hidden="true" class="inline-flex min-h-11 min-w-6 items-center justify-center text-small text-muted">
            …
          </span>
        ) : item === page ? (
          <span aria-current="page" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-ink px-4 text-small font-medium text-inv-ink">
            {item}
          </span>
        ) : (
          <Button href={hrefFor(item)} variant="outline" size="sm" class="min-w-11" aria-label={`Trang ${item}`}>
            {item}
          </Button>
        ),
      )}
      {page < pageCount ? (
        <Button href={hrefFor(page + 1)} rel="next" variant="outline" size="sm">
          Trang sau
        </Button>
      ) : null}
    </nav>
  )
}
