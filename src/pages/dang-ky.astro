---
import { actions } from 'astro:actions';
import PublicLayout from '../layouts/PublicLayout.astro';
import AuthCard from '../components/auth/AuthCard.astro';
import Button from '../components/ui/Button.astro';
import FormAlert from '../components/ui/FormAlert.astro';
import Input from '../components/ui/Input.astro';
import { submittedValues } from '../lib/auth';
import { formErrors } from '../lib/form-errors';
import { SITE_NAME } from '../lib/site';
import { PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH } from '../lib/validation/auth';
import { VN_PHONE_INPUT_PATTERN, VN_PHONE_INPUT_TITLE } from '../lib/validation/phone';

export const prerender = false;

const result = Astro.getActionResult(actions.signUp);
if (result && !result.error) return Astro.redirect(result.data.redirectTo, 303);

const values = await submittedValues(Astro.request);
const errors = formErrors(result?.error);
const next = values.next ?? Astro.url.searchParams.get('next') ?? '';
---

<PublicLayout title={`Đăng ký chủ phòng | ${SITE_NAME}`} headerSearch={false} noindex>
  <AuthCard title="Đăng ký chủ phòng" description="Tạo tài khoản để đăng phòng và nhận yêu cầu xem phòng từ người thuê.">
    {errors.form && <FormAlert class="mb-5">{errors.form}</FormAlert>}
    <form method="post" action={actions.signUp} class="grid gap-4">
      {next && <input type="hidden" name="next" value={next} />}
      <Input
        id="signup-name"
        label="Họ và tên"
        name="name"
        type="text"
        required
        maxlength={100}
        autocomplete="name"
        value={values.name}
        error={errors.fields.name}
      />
      <Input
        id="signup-email"
        label="Email"
        name="email"
        type="email"
        required
        autocomplete="email"
        value={values.email}
        error={errors.fields.email}
      />
      <Input
        id="signup-password"
        label="Mật khẩu"
        name="password"
        type="password"
        required
        minlength={PASSWORD_MIN_LENGTH}
        maxlength={PASSWORD_MAX_LENGTH}
        autocomplete="new-password"
        aria-describedby={errors.fields.password ? undefined : 'signup-password-hint'}
        error={errors.fields.password}
      />
      {!errors.fields.password && <p id="signup-password-hint" class="-mt-2.5 text-small text-muted">Ít nhất {PASSWORD_MIN_LENGTH} ký tự.</p>}
      <Input
        id="signup-phone"
        label="Số điện thoại"
        name="phone"
        type="tel"
        required
        inputmode="tel"
        autocomplete="tel"
        pattern={VN_PHONE_INPUT_PATTERN}
        title={VN_PHONE_INPUT_TITLE}
        value={values.phone}
        error={errors.fields.phone}
      />
      <Input
        id="signup-zalo"
        label="Số Zalo"
        optional
        name="zalo"
        type="tel"
        inputmode="tel"
        pattern={VN_PHONE_INPUT_PATTERN}
        title={VN_PHONE_INPUT_TITLE}
        value={values.zalo}
        error={errors.fields.zalo}
      />
      <Button type="submit" class="mt-2 w-full">Tạo tài khoản</Button>
      <p class="text-small text-muted">
        Khi tạo tài khoản, bạn đồng ý với <a href="/dieu-khoan" class="link">Điều khoản sử dụng</a> và
        <a href="/chinh-sach-bao-mat" class="link">Chính sách bảo mật</a>.
      </p>
    </form>
    <Fragment slot="footer">
      Đã có tài khoản? <a href={next ? `/dang-nhap?next=${encodeURIComponent(next)}` : '/dang-nhap'} class="link font-medium text-accent">Đăng nhập</a>
    </Fragment>
  </AuthCard>
</PublicLayout>
