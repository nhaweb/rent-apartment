---
/**
 * Target of the reset email. Better Auth checks the emailed link and
 * redirects here with `?token=...`, or with `?error=INVALID_TOKEN`.
 */
import { actions } from 'astro:actions';
import PublicLayout from '../layouts/PublicLayout.astro';
import AuthCard from '../components/auth/AuthCard.astro';
import Button from '../components/ui/Button.astro';
import FormAlert from '../components/ui/FormAlert.astro';
import Input from '../components/ui/Input.astro';
import { submittedValues } from '../lib/auth';
import { formErrors } from '../lib/form-errors';
import { SITE_NAME } from '../lib/site';
import { PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH } from '../lib/validation/auth';

export const prerender = false;

const result = Astro.getActionResult(actions.resetPassword);
if (result && !result.error) return Astro.redirect(result.data.redirectTo, 303);

const values = await submittedValues(Astro.request);
const errors = formErrors(result?.error);
const token = values.token ?? Astro.url.searchParams.get('token') ?? '';
const linkInvalid = !token || Astro.url.searchParams.has('error') || errors.fields.token !== undefined;
---

<PublicLayout title={`Đặt lại mật khẩu | ${SITE_NAME}`} headerSearch={false} noindex>
  <AuthCard title="Đặt mật khẩu mới">
    {
      linkInvalid ? (
        <>
          <FormAlert>Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn.</FormAlert>
          <Button href="/quen-mat-khau" class="mt-5 w-full">
            Gửi lại liên kết
          </Button>
        </>
      ) : (
        <>
          {errors.form && <FormAlert class="mb-5">{errors.form}</FormAlert>}
          <form method="post" action={actions.resetPassword} class="grid gap-4">
            <input type="hidden" name="token" value={token} />
            <Input
              id="reset-password"
              label="Mật khẩu mới"
              name="password"
              type="password"
              required
              minlength={PASSWORD_MIN_LENGTH}
              maxlength={PASSWORD_MAX_LENGTH}
              autocomplete="new-password"
              error={errors.fields.password}
            />
            <Input
              id="reset-confirm"
              label="Nhập lại mật khẩu mới"
              name="confirmPassword"
              type="password"
              required
              autocomplete="new-password"
              error={errors.fields.confirmPassword}
            />
            <Button type="submit" class="mt-2 w-full">Đổi mật khẩu</Button>
          </form>
        </>
      )
    }
    <Fragment slot="footer">
      <a href="/dang-nhap" class="link font-medium text-accent">Quay lại đăng nhập</a>
    </Fragment>
  </AuthCard>
</PublicLayout>
