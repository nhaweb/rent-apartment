---
/**
 * /quan-ly/tai-khoan: the landlord's name, phone (reached by renters only
 * through the "Gọi điện" redirect `/phong/[id]/goi`) and Zalo, the
 * "Nhắn Zalo" opt-in (the number is only reached through `/phong/[id]/zalo`), password,
 * signed-in devices and account deletion. Zero-JS forms; each redirects on
 * success (PRG).
 */
import { actions } from 'astro:actions';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Button from '../../components/ui/Button.astro';
import FormAlert from '../../components/ui/FormAlert.astro';
import Input from '../../components/ui/Input.astro';
import ZaloOptIn from '../../components/auth/ZaloOptIn.astro';
import { getAuthState, submittedValues } from '../../lib/auth';
import { formErrors } from '../../lib/form-errors';
import { formatPhone } from '../../lib/format';
import { deviceLabel, listOwnSessions } from '../../lib/landlord-sessions';
import { toastFromParams } from '../../lib/toast';
import { DELETE_ACCOUNT_CONFIRM_WORD, PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH } from '../../lib/validation/auth';
import { VN_PHONE_INPUT_PATTERN, VN_PHONE_INPUT_TITLE } from '../../lib/validation/phone';

export const prerender = false;

// The session is gone with the user, so check this before reading it.
const deleteResult = Astro.getActionResult(actions.deleteAccount);
if (deleteResult && !deleteResult.error) return Astro.redirect('/dang-nhap?da-xoa-tai-khoan=1', 303);

const authState = await getAuthState(Astro);
// The middleware guarantees a landlord here; this only narrows the type.
if (!authState) return Astro.redirect('/dang-nhap', 303);
const { landlord } = authState;

const profileResult = Astro.getActionResult(actions.updateProfile);
const passwordResult = Astro.getActionResult(actions.changePassword);
const revokeResult = Astro.getActionResult(actions.revokeSession);
const revokeOthersResult = Astro.getActionResult(actions.revokeOtherSessions);
if (profileResult && !profileResult.error) return Astro.redirect('/quan-ly/tai-khoan?da-luu=1', 303);
if (passwordResult && !passwordResult.error) return Astro.redirect('/quan-ly/tai-khoan?da-doi-mat-khau=1#mat-khau', 303);
if ((revokeResult && !revokeResult.error) || (revokeOthersResult && !revokeOthersResult.error)) {
  return Astro.redirect('/quan-ly/tai-khoan?da-dang-xuat-thiet-bi=1#thiet-bi', 303);
}

const submitted = await submittedValues(Astro.request);
const profileErrors = formErrors(profileResult?.error);
const passwordErrors = formErrors(passwordResult?.error);
const deleteErrors = formErrors(deleteResult?.error);
const sessionError = revokeResult?.error?.message ?? revokeOthersResult?.error?.message;
const sessions = await listOwnSessions(authState.userId, authState.sessionId);
const dateTime = new Intl.DateTimeFormat('vi-VN', {
  dateStyle: 'short',
  timeStyle: 'short',
  timeZone: 'Asia/Ho_Chi_Minh',
});
const profile = profileResult?.error
  ? {
      name: submitted.name ?? '',
      phone: submitted.phone ?? '',
      zalo: submitted.zalo ?? '',
      zaloPublic: submitted.zaloPublic === 'on',
    }
  : {
      name: landlord.name,
      phone: formatPhone(landlord.phone),
      zalo: landlord.zalo ? formatPhone(landlord.zalo) : '',
      zaloPublic: Boolean(landlord.zalo && landlord.zaloPublicAt),
    };

const toast = toastFromParams(Astro.url.searchParams, {
  'da-luu': 'Đã lưu thông tin.',
  'da-doi-mat-khau': 'Đã đổi mật khẩu.',
  'da-dang-xuat-thiet-bi': 'Đã đăng xuất thiết bị.',
});
const section = 'rounded-card border border-line bg-paper p-5 sm:p-6';
---

<DashboardLayout title="Tài khoản" toast={toast}>
  <h1 class="text-display font-medium">Tài khoản</h1>
  <p class="mt-1 text-muted">
    Email không hiện công khai. Người thuê gửi yêu cầu qua biểu mẫu, bấm gọi số điện thoại của bạn từ trang phòng, hoặc
    nhắn Zalo nếu bạn bật bên dưới.
  </p>

  <div class="mt-6 grid max-w-xl gap-6">
    <section class={section} aria-labelledby="profile-heading">
      <h2 id="profile-heading" class="text-title font-medium">Thông tin liên hệ</h2>
      {profileErrors.form && <FormAlert class="mt-4">{profileErrors.form}</FormAlert>}
      <form method="post" action={actions.updateProfile} class="mt-5 grid gap-4">
        <div>
          <p class="mb-1.5 text-small font-medium text-ink">Email</p>
          <p class="break-all text-muted">{landlord.email}</p>
          <p class="mt-1 text-small text-muted">Dùng để đăng nhập và nhận thông báo. Chưa đổi được email.</p>
        </div>
        <Input
          id="profile-name"
          label="Họ và tên"
          name="name"
          type="text"
          required
          maxlength={100}
          autocomplete="name"
          value={profile.name}
          error={profileErrors.fields.name}
        />
        <Input
          id="profile-phone"
          label="Số điện thoại"
          name="phone"
          type="tel"
          required
          inputmode="tel"
          autocomplete="tel"
          pattern={VN_PHONE_INPUT_PATTERN}
          title={VN_PHONE_INPUT_TITLE}
          value={profile.phone}
          error={profileErrors.fields.phone}
        />
        <Input
          id="profile-zalo"
          label="Số Zalo"
          optional
          name="zalo"
          type="tel"
          inputmode="tel"
          pattern={VN_PHONE_INPUT_PATTERN}
          title={VN_PHONE_INPUT_TITLE}
          value={profile.zalo}
          error={profileErrors.fields.zalo}
        />
        <ZaloOptIn id="profile-zalo-public" zaloInputId="profile-zalo" checked={profile.zaloPublic} error={profileErrors.fields.zaloPublic} />
        <div>
          <Button type="submit">Lưu thông tin</Button>
        </div>
      </form>
    </section>

    <section id="mat-khau" class={`${section} scroll-mt-24`} aria-labelledby="password-heading">
      <h2 id="password-heading" class="text-title font-medium">Đổi mật khẩu</h2>
      <p class="mt-1 text-small text-muted">Các thiết bị khác đang đăng nhập sẽ bị đăng xuất.</p>
      {passwordErrors.form && <FormAlert class="mt-4">{passwordErrors.form}</FormAlert>}
      <form method="post" action={`${actions.changePassword}#mat-khau`} class="mt-5 grid gap-4">
        <!-- Lets password managers match the account. -->
        <input type="hidden" name="username" value={landlord.email} autocomplete="username" />
        <Input
          id="password-current"
          label="Mật khẩu hiện tại"
          name="currentPassword"
          type="password"
          required
          autocomplete="current-password"
          error={passwordErrors.fields.currentPassword}
        />
        <Input
          id="password-new"
          label="Mật khẩu mới"
          name="password"
          type="password"
          required
          minlength={PASSWORD_MIN_LENGTH}
          maxlength={PASSWORD_MAX_LENGTH}
          autocomplete="new-password"
          error={passwordErrors.fields.password}
        />
        <Input
          id="password-confirm"
          label="Nhập lại mật khẩu mới"
          name="confirmPassword"
          type="password"
          required
          autocomplete="new-password"
          error={passwordErrors.fields.confirmPassword}
        />
        <div>
          <Button type="submit" variant="outline">Đổi mật khẩu</Button>
        </div>
      </form>
    </section>

    <section id="thiet-bi" class={`${section} scroll-mt-24`} aria-labelledby="devices-heading">
      <h2 id="devices-heading" class="text-title font-medium">Thiết bị đang đăng nhập</h2>
      <p class="mt-1 text-small text-muted">Thấy thiết bị lạ? Đăng xuất thiết bị đó rồi đổi mật khẩu.</p>
      {sessionError && <FormAlert class="mt-4">{sessionError}</FormAlert>}
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {
          sessions.map((device) => (
            <li class="flex flex-wrap items-center justify-between gap-3 py-3">
              <div class="min-w-0">
                <p class="font-medium">
                  {deviceLabel(device.userAgent)}
                  {device.current && <span class="ml-2 text-small font-normal text-accent-strong">Thiết bị này</span>}
                </p>
                <p class="text-small text-muted">
                  Đăng nhập {dateTime.format(device.createdAt)} · hoạt động {dateTime.format(device.updatedAt)}
                </p>
              </div>
              {!device.current && (
                <form method="post" action={`${actions.revokeSession}#thiet-bi`}>
                  <input type="hidden" name="sessionId" value={device.id} />
                  <Button type="submit" variant="ghost" size="sm">
                    Đăng xuất
                  </Button>
                </form>
              )}
            </li>
          ))
        }
      </ul>
      {
        sessions.length > 1 && (
          <form method="post" action={`${actions.revokeOtherSessions}#thiet-bi`} class="mt-4">
            <Button type="submit" variant="outline" size="sm">
              Đăng xuất mọi thiết bị khác
            </Button>
          </form>
        )
      }
    </section>

    <section id="xoa-tai-khoan" class={`${section} scroll-mt-24`} aria-labelledby="delete-heading">
      <h2 id="delete-heading" class="text-title font-medium">Xóa tài khoản</h2>
      <p class="mt-1 text-small text-muted">
        Xóa vĩnh viễn tài khoản, mọi phòng, ảnh và yêu cầu liên hệ của bạn. Không thể hoàn tác.
      </p>
      {deleteErrors.form && <FormAlert class="mt-4">{deleteErrors.form}</FormAlert>}
      <form method="post" action={`${actions.deleteAccount}#xoa-tai-khoan`} class="mt-5 grid gap-4">
        <input type="hidden" name="username" value={landlord.email} autocomplete="username" />
        <Input
          id="delete-password"
          label="Mật khẩu hiện tại"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          error={deleteErrors.fields.password}
        />
        <Input
          id="delete-confirm"
          label={`Gõ ${DELETE_ACCOUNT_CONFIRM_WORD} để xác nhận`}
          name="confirm"
          type="text"
          required
          autocomplete="off"
          maxlength={20}
          error={deleteErrors.fields.confirm}
        />
        <div>
          <Button type="submit" variant="danger">Xóa tài khoản vĩnh viễn</Button>
        </div>
      </form>
    </section>
  </div>
</DashboardLayout>
